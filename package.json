{
  "name": "dsh-cron",
  "version": "0.2.0",
  "description": "DSH 侧栏「定时任务」：自带 cron 调度内核与执行账本，可建任务、改表达式、启停、手动执行，并把脚本输出投递到 Discord。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cron",
    "scheduler",
    "discord",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkaneRanma/dsh-cron.git"
  },
  "homepage": "https://github.com/AkaneRanma/dsh-cron#readme",
  "bugs": {
    "url": "https://github.com/AkaneRanma/dsh-cron/issues"
  },
  "author": "AkaneRanma",
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT"
}
